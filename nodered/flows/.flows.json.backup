    {
        "id": "fn_parser_capteurs",
        "type": "function",
        "z": "f60b1cd2f9264b44",
        "name": "Parser JSON pour InfluxDB",
        "func": "// ==========================================================\n// NŒUD FUNCTION : Parser JSON pour InfluxDB (Capteurs) - CORRIGÉ\n// ==========================================================\n\nconst topicParts = msg.topic.split('/');\nconst typeMesure = topicParts[topicParts.length - 1]; // \"temperature\", \"courant\", etc.\nconst login = topicParts[1];                          // \"grp_c\"\nconst valeur = parseFloat(msg.payload);\n\n// Sécurité : Vérification du format numérique\nif (isNaN(valeur) || !isFinite(valeur)) {\n    node.error(\"❌ Valeur non numérique: \" + msg.payload);\n    return null;\n}\n\n// Sécurité : Vérification du type de mesure\nif (!typeMesure || typeMesure === '') {\n    node.error(\"❌ Type de mesure vide\");\n    return null;\n}\n\n// FORMAT CONFORME INFLUXDB V2 (Case Measurement vide dans l'UI)\nmsg.measurement = typeMesure; // Placé à la racine pour que le nœud le trouve direct !\nmsg.tags = {\n    capteur: login,\n    site: 'campus_ufhb'\n};\nmsg.payload = {\n    valeur: valeur // InfluxDB prendra automatiquement les clés du payload comme \"fields\"\n};\n\nnode.log(\"✅ \" + msg.measurement + \" = \" + valeur);\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 380,
        "wires": [
            [
                "node_influx_final",
                "debug_formate"
            ]
        ]
    },
