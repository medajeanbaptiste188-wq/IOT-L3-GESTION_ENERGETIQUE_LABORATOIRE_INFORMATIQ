    {
        "id": "fn_parser_alertes",
        "type": "function",
        "z": "f60b1cd2f9264b44",
        "name": "Formater Alertes",
        "func": "let alerte = msg.payload; \n\n// SÉCURITÉ : Si le payload est reçu sous forme de texte (string), on le convertit en objet\nif (typeof alerte === 'string') {\n    try {\n        alerte = JSON.parse(alerte);\n    } catch(e) {\n        return null; // On ignore si ce n'est pas du JSON valide\n    }\n}\n\n// On tente maintenant de convertir les valeurs en nombres décimaux\nconst valeurNum = parseFloat(alerte.valeur);\nconst seuilNum = parseFloat(alerte.seuil);\n\n// SÉCURITÉ ANTI-NaN\nif (isNaN(valeurNum) || isNaN(seuilNum)) {\n    node.warn(\"⚠️ Alerte ignorée pour InfluxDB (Données numériques invalides) : \" + JSON.stringify(alerte));\n    return null; \n}\n\n// FORMAT CONFORME INFLUXDB V2\nmsg.measurement = \"alertes\"; \nmsg.tags = {\n    type_anomalie: alerte.type || \"inconnu\",\n    capteur: \"grp_c\",\n    site: 'campus_ufhb'\n};\n\nmsg.payload = {\n    valeur: valeurNum,\n    seuil: seuilNum,\n    message: alerte.message || \"Aucun message\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 480,
        "wires": [
            [
                "node_influx_final"
            ]
        ]
    },
