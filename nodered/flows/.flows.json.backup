    {
        "id": "04804a61e29c1187",
        "type": "function",
        "z": "f60b1cd2f9264b44",
        "name": "Préparer le Mail",
        "func": "let alerte = msg.payload;\n\n// SÉCURITÉ : Si le payload est reçu sous forme de texte (string), on le convertit en objet\nif (typeof alerte === 'string') {\n    try {\n        alerte = JSON.parse(alerte);\n    } catch (e) {\n        node.error(\"Erreur critique : Impossible de décoder le JSON du mail.\");\n        return null;\n    }\n}\n\n// 💡 DÉTECTION AUTOMATIQUE DE L'UNITÉ\nlet unite = \"\";\nconst typeLower = alerte.type ? alerte.type.toLowerCase() : \"\";\n\nif (typeLower.includes(\"temp\")) {\n    unite = \" °C\";\n} else if (typeLower.includes(\"hum\")) {\n    unite = \" %\";\n} else if (typeLower.includes(\"courant\") || typeLower.includes(\"amp\")) {\n    unite = \" mA\"; // Change en \" A\" si ton ESP32 envoie directement des Ampères\n} else if (typeLower.includes(\"tension\") || typeLower.includes(\"volt\")) {\n    unite = \" V\";\n} else if (typeLower.includes(\"lum\")) {\n    unite = \" lux\";\n}\n\n// 1. On définit le sujet du mail\nconst typeAlerte = alerte.type ? alerte.type.toUpperCase() : \"INCONNU\";\nmsg.topic = `🚨 ALERTE CRITIQUE : Anomalie ${typeAlerte} détectée !`;\n\n// 2. On écrit le corps du mail avec les unités dynamiques\nmsg.payload = `Bonjour l'administrateur,\\n\\n` +\n    `Une anomalie a été détectée sur le système de surveillance du Campus UFHB.\\n\\n` +\n    ` DÉTAILS DE L'ALERTE :\\n` +\n    `----------------------------------------\\n` +\n    `• Type de capteur : ${alerte.type || \"Non spécifié\"}\\n` +\n    `• Valeur mesurée : ${alerte.valeur ?? \"N/A\"}${unite}\\n` +\n    `• Seuil critique : ${alerte.seuil ?? \"N/A\"}${unite}\\n` +\n    `• Message d'erreur : ${alerte.message || \"Aucun détail\"}\\n` +\n    `----------------------------------------\\n\\n` +\n    `Veuillez vérifier l'état du laboratoire ou les graphiques sur Grafana (http://localhost:3000).\\n\\n` +\n    `Ceci est un message automatique envoyé par Node-RED.`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
